#include <stdio.h>
#include <stdlib.h>

int main() {
	float valori, dsct, total;
	printf("Digite o valor da compra: ");
	scanf("%f", &valori);
	
	if (valori >= 500) {
		dsct = (20*valori)/100;
		total = valori - dsct;
		}
	else {
		dsct = (15*valori)/100;
		total = valori - dsct;
		}
		
	printf("O valor inicial da compra = %0.2f", valori);
	printf("O valor do desconto obtido = %0.2f", dsct);
	printf("O valor a ser pago = %0.2f", total);
	
	system("pause");
	return 0;
}